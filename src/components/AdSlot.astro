---
interface Props {
  slot: string;
  format?: string;
  fullWidthResponsive?: boolean;
  /** Variante visuelle : 'in-article' (avec marges) | 'sidebar' (compact) */
  variant?: 'in-article' | 'sidebar';
}

const {
  slot,
  format = 'auto',
  fullWidthResponsive = true,
  variant = 'in-article',
} = Astro.props;
---

<aside class={`ad-slot ad-slot--${variant}`} aria-label="Annonce publicitaire">
  <span class="ad-slot__label">Publicité</span>
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="ca-pub-4020973443671350"
       data-ad-slot={slot}
       data-ad-format={format}
       data-full-width-responsive={fullWidthResponsive ? 'true' : 'false'}></ins>
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</aside>

<style>
  .ad-slot {
    display: block;
    text-align: center;
    overflow: hidden;
  }

  .ad-slot__label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--clr-text-faint);
    margin-bottom: 0.4em;
  }

  /* Variante "in-article" : utilisée avant le contenu et avant les articles liés */
  .ad-slot--in-article {
    margin-block: var(--space-6);
    min-height: 100px;
  }

  /* Variante "sidebar" : compacte, dans la colonne latérale */
  .ad-slot--sidebar {
    margin-top: var(--space-5);
    min-height: 250px;
  }

  .ad-slot ins.adsbygoogle {
    margin: 0 auto;
  }
</style>
